<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-android;net8.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>FieldLead.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>FieldLead</ApplicationTitle>
    <ApplicationId>com.fieldlead.mobile</ApplicationId>
    <ApplicationIdGuid>3c842067-3c8c-4d30-83ad-ff2ddcaad419</ApplicationIdGuid>
    <SupportedOSPlatformVersion Condition=" '$(TargetFramework)' == 'net8.0-ios' ">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition=" '$(TargetFramework)' == 'net8.0-android' ">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.92" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.92" />
    <PackageReference Include="Microsoft.Maui.Controls.Maps" Version="8.0.92" />
    <PackageReference Include="SQLite-net-pcl" Version="1.9.172" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.58.0" />
    <PackageReference Include="CommunityToolkit.Maui" Version="9.1.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <MauiFont Include="Resources/Fonts/*.ttf" Alias="*" />
    <MauiImage Include="Resources/Images/*" />
    <None Include="Resources/Raw/*" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
