<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FieldLead.Mobile.Pages.LoginPage"
             Title="Sign in">
    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Image Source="dotnet_bot.png" HeightRequest="120" HorizontalOptions="Center" />
        <Label Text="Sign in to Field Lead" FontSize="24" HorizontalOptions="Center" />
        <Button Text="Sign in with Entra ID"
                Command="{Binding SignInCommand}" />
        <Label Text="Signed in as:"
               IsVisible="{Binding IsSignedIn}" />
        <Label Text="{Binding AccountDisplayName}"
               FontAttributes="Bold"
               IsVisible="{Binding IsSignedIn}" />
    </VerticalStackLayout>
</ContentPage>
