<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FieldLead.Mobile.Pages.SiteDetailPage"
             Title="Site Detail">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="{Binding Site.Name}" FontSize="24" FontAttributes="Bold" />
            <Label Text="{Binding Site.Address}" />
            <Button Text="Capture Photo" Command="{Binding CapturePhotoCommand}" />
            <CollectionView ItemsSource="{Binding Photos}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="0" Margin="0,8">
                            <Image Source="{Binding LocalPath}" Aspect="AspectFill" HeightRequest="200" />
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
