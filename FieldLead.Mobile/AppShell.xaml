<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:FieldLead.Mobile.Pages"
    x:Class="FieldLead.Mobile.AppShell"
    Title="Field Lead">
    <FlyoutItem Title="Map" Route="map">
        <ShellContent ContentTemplate="{DataTemplate pages:MapPage}" />
    </FlyoutItem>
    <ShellContent Route="siteDetail" ContentTemplate="{DataTemplate pages:SiteDetailPage}" />
    <ShellContent Route="login" ContentTemplate="{DataTemplate pages:LoginPage}" />
</Shell>
